# Jarvis env — copy to .env and fill in secrets:
#   cp .env.example .env

# LLM: groq (default) | ollama
JARVIS_LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# low | medium | high  (gpt-oss reasoning; low is best for voice latency)
GROQ_REASONING_EFFORT=low

# Local fallback (JARVIS_LLM_PROVIDER=ollama)
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://localhost:11434/api/chat

# Shared generation knobs
JARVIS_MAX_TOKENS=50
JARVIS_TEMPERATURE=0.7
JARVIS_TOP_P=0.9
# Slightly longer when summarizing web search for speech
JARVIS_SEARCH_MAX_TOKENS=120

# Tavily web search — https://app.tavily.com/home
# Used by brain commands: "google …", "search …", and live-fact auto-detect
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# Spotify playback — Premium required. One-time auth:
#   1. Create app at https://developer.spotify.com/dashboard
#   2. Add redirect URI: http://127.0.0.1:8732/callback
#   3. Fill CLIENT_ID + CLIENT_SECRET below
#   4. cd services/brain && .venv/bin/python spotify_auth.py
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8732/callback

# TTS: cartesia (default) | kokoro
JARVIS_TTS_PROVIDER=cartesia

# Cartesia — https://play.cartesia.ai/keys
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.5
# Archie en-GB male (browse more: https://play.cartesia.ai/voices)
CARTESIA_VOICE_ID=ef191366-f52f-447a-a398-ed8c0f2943a1
CARTESIA_SAMPLE_RATE=44100
CARTESIA_LANGUAGE=en
# Speech rate 0.6–1.5 (1.0 natural). Mild bump shortens playtime.
CARTESIA_SPEED=1.15

# Local Kokoro fallback (JARVIS_TTS_PROVIDER=kokoro)
# KOKORO_VOICE=bm_lewis

# STT: cartesia (default, Ink-2) | whisper
JARVIS_STT_PROVIDER=cartesia
CARTESIA_STT_MODEL=ink-2
CARTESIA_STT_SAMPLE_RATE=16000
# Optional turn-detection tuning (responsive profile examples):
# CARTESIA_STT_START_THRESHOLD=0.7
# CARTESIA_STT_EAGER_END_THRESHOLD=0.5
# CARTESIA_STT_END_THRESHOLD=0.4
# CARTESIA_STT_END_TIMEOUT_MS=4500
