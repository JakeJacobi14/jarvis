# Jarvis env — copy to .env and fill in secrets:
#   cp .env.example .env

# LLM: groq (default) | ollama
JARVIS_LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# low | medium | high  (gpt-oss reasoning; low is best for voice latency)
GROQ_REASONING_EFFORT=low

# Local fallback (JARVIS_LLM_PROVIDER=ollama)
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://localhost:11434/api/chat

# Shared generation knobs
JARVIS_MAX_TOKENS=50
JARVIS_TEMPERATURE=0.7
JARVIS_TOP_P=0.9
# Slightly longer when summarizing web search for speech
JARVIS_SEARCH_MAX_TOKENS=120

# Tavily web search — https://app.tavily.com/home
# Used by brain commands: "google …", "search …", and live-fact auto-detect
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# Spotify playback — Premium required. One-time auth:
#   1. Create app at https://developer.spotify.com/dashboard
#   2. Add redirect URI: http://127.0.0.1:8732/callback
#   3. Fill CLIENT_ID + CLIENT_SECRET below
#   4. cd services/brain && .venv/bin/python spotify_auth.py
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8732/callback

# Built-in Spotify Connect speaker (spotifyd) so no Spotify app must be open.
# start.sh downloads the binary on first run. Sign in once:
#   ./start.sh --spotify-login
# auto = run it when signed in | off = never
JARVIS_SPOTIFY_LOCAL_DEVICE=auto
JARVIS_SPOTIFY_DEVICE=Jarvis
JARVIS_SPOTIFY_BITRATE=160
# JARVIS_SPOTIFYD_VERSION=0.4.2

# TTS: cartesia (default) | kokoro
JARVIS_TTS_PROVIDER=cartesia

# Cartesia — https://play.cartesia.ai/keys
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.5
# Archie en-GB male (browse more: https://play.cartesia.ai/voices)
CARTESIA_VOICE_ID=ef191366-f52f-447a-a398-ed8c0f2943a1
CARTESIA_SAMPLE_RATE=44100
CARTESIA_LANGUAGE=en
# Speech rate 0.6–1.5 (1.0 natural). Mild bump shortens playtime.
CARTESIA_SPEED=1.15

# Local Kokoro fallback (JARVIS_TTS_PROVIDER=kokoro)
# KOKORO_VOICE=bm_lewis

# STT: cartesia (default, Ink-2) | whisper
JARVIS_STT_PROVIDER=cartesia
CARTESIA_STT_MODEL=ink-2
CARTESIA_STT_SAMPLE_RATE=16000
# Optional turn-detection tuning (responsive profile examples):
# CARTESIA_STT_START_THRESHOLD=0.7
# CARTESIA_STT_EAGER_END_THRESHOLD=0.5
# CARTESIA_STT_END_THRESHOLD=0.4
# CARTESIA_STT_END_TIMEOUT_MS=4500

# Mic for wake word + STT. Index or name from:
#   services/mic-wakeword/.venv/bin/python -m sounddevice
# Leave unset to use the OS default input.
# JARVIS_MIC_DEVICE=2
# JARVIS_MIC_DEVICE=USB

# Headless box: skip Spacebar PTT (auto-off when no DISPLAY). Force with 1/0.
# JARVIS_PTT=auto

# Phone / LAN control panel (stays up when voice is stopped)
JARVIS_CONTROL_HOST=0.0.0.0
JARVIS_CONTROL_PORT=8740
# Optional PIN so random LAN clients can't start/stop him
# JARVIS_CONTROL_PIN=1234
# Hold-to-speak needs https. On by default; the panel also accepts http and
# redirects. Accept the certificate warning once per device.
JARVIS_CONTROL_TLS=1
# Model used to transcribe phone audio (Groq; falls back to Cartesia ink-whisper)
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Weather (Open-Meteo, no API key). Quote names that contain spaces or commas.
# JARVIS_CITY="West Lafayette, Indiana"
JARVIS_CITY=
# JARVIS_LAT=
# JARVIS_LON=
# JARVIS_PLACE_NAME=home
# JARVIS_TIMEZONE=auto
# JARVIS_TEMP_UNIT=celsius

# Sonos Amp — Spotify + volume. Speech stays on this PC unless you opt in.
JARVIS_AUDIO_OUTPUT=auto
# local (default) = Jarvis talks on the computer; Spotify keeps the Amp
# sonos = also speak through the Amp (interrupts music)
JARVIS_TTS_OUTPUT=local
# JARVIS_SONOS_NAME=Bedroom
# JARVIS_SONOS_IP=192.168.4.24
# JARVIS_SONOS_HTTP_PORT=8742

# RGB strip via WLED (ESP8266/ESP32). Example: 192.168.1.50
# WLED_HOST=

# Or generic bulbs through Home Assistant
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# HA_LIGHT_ENTITY=light.living_room

# Camera stills. 0 = default device. Linux override: /dev/video0
# JARVIS_CAMERA_INDEX=0
# JARVIS_CAMERA_DEVICE=
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Dashcam clips — "Jarvis, clip that" saves the last stretch of camera + mic.
# Recording runs continuously into a rolling buffer; needs ffmpeg.
JARVIS_CLIP_ENABLED=1
# Default clip length, and the longest tail you can ask for.
JARVIS_CLIP_SECONDS=30
JARVIS_CLIP_MAX_SECONDS=90
# Smaller segments = tighter clip boundaries, more files.
# JARVIS_CLIP_SEGMENT_SECONDS=2
# JARVIS_CLIP_FPS=30
# JARVIS_CLIP_VIDEO_BITRATE=2500k
# JARVIS_CLIP_MAX_WIDTH=1280
# Force a capture resolution only if the default one misbehaves.
# JARVIS_CLIP_VIDEO_SIZE=1280x720
# Record the mic alongside video (0 = silent video).
JARVIS_CLIP_AUDIO=1
# macOS: avfoundation indices. Linux: /dev/videoN and an ALSA device.
# JARVIS_CLIP_VIDEO_DEVICE=0
# JARVIS_CLIP_AUDIO_DEVICE=0
